; Engine configuration file. Project restarted 2026-11-07.
; The old OpenCode attempt lives in ../trauma-village (not to be reused).

config_version=5

[application]

config/name="Empty Night"
config/description="PS2-style survival horror set in present-day Linia, Kashubia."
run/main_scene="res://scenes/linia_ps2.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.015, 0.02, 1)

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
